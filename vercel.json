{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix web ci",
  "buildCommand": "npm --prefix web run build",
  "outputDirectory": "web/dist",
  "routes": [
    {
      "src": "^/api/(v1(?:/.*)?)$",
      "dest": "/api/index?__placement_route=$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/api(?:/.*)?$",
      "status": 404
    },
    {
      "src": "^/.*$",
      "dest": "/index.html"
    }
  ]
}
